# --- Terraform ---
# Ignore ALL terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Ignore ALL variable files (where you store passwords)
*.tfvars
*.tfvars.json

# Ignore the terraform binary folders
.terraform/
crash.log

# --- Ansible ---
**/ansible.log
**/vault_pass.txt
inventory.ini

# --- WireGuard Keys ---
# Never commit actual keys fetched or generated locally
privatekey
publickey
client_*.conf
*.key

# --- Kubernetes & Talos ---
talosconfig
kubeconfig
*.kubeconfig

# --- SSH & Certificates ---
*.pem
id_rsa
id_ed25519

# --- General & System ---
.DS_Store
.env
/tmp/acme.json
/tmp/*.json

# --- App Data ---
services/kafka-connect/cassandra_data/