global:
  checkNewVersion: false
  sendAnonymousUsage: false

api:
  dashboard: true
  insecure: true

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"

  # 🚀 Added dedicated health check port to stop "Peeking" timeout logs
  traefik_health:
    address: ":8082"

ping:
  entryPoint: traefik_health

providers:
  docker:
    exposedByDefault: false
  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: INFO

# 🛡️ Only the Primary Node (index 0) handles Let's Encrypt
{% if inventory_hostname == groups['traefik_nodes'][0] %}
certificatesResolvers:
  route53_aws:
    acme:
      email: {{ traefik_acme_email }} 
      storage: /etc/traefik/acme.json
      dnsChallenge:
        provider: route53
        delayBeforeCheck: 90
        resolvers: ["1.1.1.1:53", "8.8.8.8:53"]
{% endif %}