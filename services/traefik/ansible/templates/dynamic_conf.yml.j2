http:
  middlewares:
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

    forwarded-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"

  serversTransports:
    unifi-transport:
      insecureSkipVerify: true

    proxmox-transport:
      insecureSkipVerify: true

  routers:
    http-catchall:
      rule: "HostRegexp(`{host:.+}`)"
      entryPoints:
        - web
      middlewares:
        - https-redirect
      service: noop@internal

    traefik-dashboard:
      rule: Host(`traefik.mwakilishi.com`)
      entryPoints:
        - websecure
      service: api@internal
      tls:
        certResolver: route53_aws

