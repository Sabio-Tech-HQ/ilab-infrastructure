global:
  scrape_interval: 15s

scrape_configs:
  - job_name: kafka_connect_source_ip_stats
    metrics_path: /metrics
    static_configs:
      - targets:
{% for ip in kafka_brokers %}
        - "{{ ip }}:8090"
{% endfor %}

  # Scrape Prometheus itself
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # Scrape Loki metrics
  - job_name: "loki"
    static_configs:
      - targets: ["loki:3100"]