// SECTION: TARGETS

loki.write "default" {
    endpoint {
        // We use the variable from global_vars.yml
        url = "{{ loki_url }}"
    }
    external_labels = {}
}

prometheus.remote_write "default" {
    endpoint {
        // Pointing to the prometheus container on the same network
        url = "http://prometheus:9090/api/v1/write"
    }
}

// SECTION: SYSTEM LOGS & JOURNAL

loki.source.journal "journal" {
    max_age       = "24h0m0s"
    relabel_rules = discovery.relabel.journal.rules
    forward_to    = [loki.write.default.receiver]
    labels        = {instance = constants.hostname, job = "system-journal"}
    path          = "/var/log/journal" 
}

local.file_match "system" {
    path_targets = [{
        __address__ = "localhost",
        __path__    = "/var/log/{syslog,messages,*.log}",
        instance    = constants.hostname,
        job         = "system-logs",
    }]
}

discovery.relabel "journal" {
    targets = []
    rule {
        source_labels = ["__journal__systemd_unit"]
        target_label  = "unit"
    }
    rule {
        source_labels = ["__journal_priority_keyword"]
        target_label  = "level"
    }
}

loki.source.file "system" {
    targets    = local.file_match.system.targets
    forward_to = [loki.write.default.receiver]
}

// SECTION: SYSTEM METRICS (Node Exporter)

prometheus.exporter.unix "metrics" {
    disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
    enable_collectors = ["meminfo"]
}

prometheus.scrape "metrics" {
    scrape_interval = "15s"
    targets    = prometheus.exporter.unix.metrics.targets
    forward_to = [prometheus.remote_write.default.receiver]
}

// SECTION: DOCKER METRICS (cAdvisor)

prometheus.exporter.cadvisor "dockermetrics" {
    docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "dockermetrics" {
    targets    = prometheus.exporter.cadvisor.dockermetrics.targets
    forward_to = [prometheus.remote_write.default.receiver]
    scrape_interval = "10s"
}

// SECTION: DOCKER LOGS

discovery.docker "dockerlogs" {
    host = "unix:///var/run/docker.sock"
}

discovery.relabel "dockerlogs" {
    targets = discovery.docker.dockerlogs.targets
    rule {
        source_labels = ["__meta_docker_container_name"]
        regex = "/(.*)"
        target_label = "service_name"
    }
}

loki.source.docker "default" {
    host       = "unix:///var/run/docker.sock"
    targets    = discovery.relabel.dockerlogs.output
    labels     = {"platform" = "docker"}
    forward_to = [loki.write.default.receiver]
}