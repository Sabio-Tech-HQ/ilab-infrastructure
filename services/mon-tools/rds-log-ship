#!/usr/bin/env python3
"""rds-log-ship — ship RDS CloudWatch logs into the ELK stack.

Pulls new events from RDS log groups via `aws logs filter-log-events` and POSTs
them to Logstash's HTTP input (mon-tools :8080) with vm_name routing →
data streams logs-rds_<name>-default. Cursor per group in state.json.

Cron: /etc/cron.d/rds-log-ship (every 5 min).  Ops: rds-log-ship [--dry-run]
"""
import json
import os
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

GROUPS = {
    "/aws/rds/instance/sabio-shared-pg18/postgresql": "rds_shared_pg18",
    "/aws/rds/cluster/mwakilishidb/error": "rds_mwakilishi_mysql_legacy",
}
LOGSTASH = "http://10.10.10.90:8080"
STATE = os.path.expanduser("~/.config/rds-log-ship/state.json")


def log(msg):
    line = "[%s] %s" % (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg)
    print(line, flush=True)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(os.path.join(os.path.dirname(STATE), "watch.log"), "a") as f:
        f.write(line + "\n")


def main():
    dry = "--dry-run" in sys.argv
    state = json.load(open(STATE)) if os.path.exists(STATE) else {}
    total = 0
    for group, dataset in GROUPS.items():
        start_ms = state.get(group, int((time.time() - 3600) * 1000))
        r = subprocess.run(
            ["aws", "logs", "filter-log-events",
             "--log-group-name", group,
             "--start-time", str(start_ms + 1),
             "--limit", "500"],
            capture_output=True, text=True, timeout=60)
        try:
            events = json.loads(r.stdout).get("events", [])
        except Exception:
            log("%s: aws cli error %s" % (dataset, r.stderr[:100]))
            continue
        if not events:
            continue
        batch = json.dumps([
            {"vm_name": dataset, "message": e["message"],
             "@timestamp": datetime.utcfromtimestamp(
                 e["timestamp"] / 1000).isoformat() + "Z"}
            for e in events]).encode()
        if not dry:
            req = urllib.request.Request(LOGSTASH, data=batch,
                                         headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=30)
        state[group] = max(e["timestamp"] for e in events)
        total += len(events)
    if not dry:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        json.dump(state, open(STATE, "w"))
    log("shipped %d events%s" % (total, " (dry-run)" if dry else ""))


if __name__ == "__main__":
    main()
