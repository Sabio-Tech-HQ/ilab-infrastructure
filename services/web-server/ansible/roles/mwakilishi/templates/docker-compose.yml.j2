services:
  mwakilishi-db:
    image: postgres:17-alpine
    container_name: mwakilishi-db
    restart: always
    environment:
      POSTGRES_DB: "{{ mwakilishi_db_name }}"
      POSTGRES_USER: "{{ mwakilishi_db_user }}"
      POSTGRES_PASSWORD: "{{ mwakilishi_db_password }}"
    ports:
      - "5432:5432"
    volumes:
      - "{{ mwakilishi_base_dir }}/db_data:/var/lib/postgresql/data"
    networks:
      - mwakilishi-net

  mwakilishi-app:
    image: drupal:11-apache
    container_name: mwakilishi-app
    restart: always
    depends_on:
      - mwakilishi-db
    ports:
      - "8085:80"
    networks:
      - mwakilishi-net
      - traefik-public
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.mwakilishi.rule=Host(`{{ mwakilishi_domain }}`)"
      - "traefik.http.routers.mwakilishi.entrypoints=websecure"
      - "traefik.http.routers.mwakilishi.tls.certresolver=route53_aws"
      - "traefik.http.services.mwakilishi.loadbalancer.server.port=80"

networks:
  mwakilishi-net:
  traefik-public:
    external: true