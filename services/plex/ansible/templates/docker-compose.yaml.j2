  plex:
    image: lscr.io/linuxserver/plex:latest
    container_name: plex
    network_mode: host
    #logging: 
    #  driver: loki
    #  options:
    #    loki-url: "{{ loki_url }}"
    #labels:
    #  - "com.centurylinklabs.watchtower.enable=true"
    environment:
      - PUID={{ admin_uid }}
      - PGID={{ admin_gid }}
      - TZ={{ timezone }}
      - VERSION=docker
      - PLEX_CLAIM={{ plex_claim_token }}
    volumes:
      - {{ plex_root }}/config:/config
      - {{ video_path }}/series:/tv
      - {{ video_path }}/movies:/movies
      - {{ video_path }}/whisparr:/whisparr
      - {{ music_path }}:/music
    restart: unless-stopped
