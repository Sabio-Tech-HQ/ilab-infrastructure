[Unit]
Description=OpenCode Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jthairu
Group=jthairu
WorkingDirectory=/home/jthairu

ExecStart=/home/jthairu/.opencode/bin/opencode web --hostname 0.0.0.0 --port 4096

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target